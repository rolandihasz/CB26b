clean: compiler_clean 
	-$(DEL_FILE) release\gtest-all.o release\gmock-all.o release\databasemanager.o release\eagleeye_classifier.o release\telemetrymanager.o release\main_test.o release\test_databasemanager.o release\test_eagleeye_classifier.o release\test_telemetrymanager.o release\moc_databasemanager.o release\moc_telemetrymanager.o

distclean: clean 
	-$(DEL_FILE) D:\cb26\tests\target_wrapper.bat
	-$(DEL_FILE) $(DESTDIR_TARGET)
	-$(DEL_FILE) Makefile.Release

check: first
	call D:\cb26\tests\target_wrapper.bat $(TESTRUNNER) release\$(TARGET) $(TESTARGS)

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

benchmark: first

compiler_no_pch_compiler_make_all:
compiler_no_pch_compiler_clean:
compiler_rcc_make_all:
compiler_rcc_clean:
compiler_moc_predefs_make_all: release/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) release\moc_predefs.h
release/moc_predefs.h: F:/Qt/6.12.0/llvm-mingw_64/mkspecs/features/data/dummy.cpp
	clang++ -O2 -std=gnu++2b -Wall -Wextra -Wextra -Wno-ignored-attributes -dM -E -o release\moc_predefs.h F:\Qt\6.12.0\llvm-mingw_64\mkspecs\features\data\dummy.cpp

compiler_moc_header_make_all: release/moc_databasemanager.cpp release/moc_telemetrymanager.cpp
compiler_moc_header_clean:
