####### Install

install_target: first FORCE
	@if not exist F:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.12.0\llvm-mingw_64\tests\tests mkdir F:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.12.0\llvm-mingw_64\tests\tests & if not exist F:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.12.0\llvm-mingw_64\tests\tests exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) F:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.12.0\llvm-mingw_64\tests\tests\$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) F:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.12.0\llvm-mingw_64\tests\tests\$(TARGET)
	-$(DEL_DIR) F:$(INSTALL_ROOT:@msyshack@%=%)\Qt\6.12.0\llvm-mingw_64\tests\tests 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

