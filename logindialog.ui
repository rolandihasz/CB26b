  <property name="styleSheet">
   <string notr="true">/* ===================================================================
   COFFEEBREAK TELEMETRY - WORLD CLASS MISSION CONTROL THEME
   LOGIN DIALOG
   =================================================================== */

QDialog#LoginDialog {
    background-color: #0b0f19;
    color: #f8fafc;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', 'Roboto', sans-serif;
    font-size: 11px;
}

/* --- Top Utility Bar --- */
QWidget#topBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #151e30, stop:1 #0c121e);
    border-bottom: 1px solid #1e293b;
}

QLabel#m_timeLabel {
    color: #38bdf8;
    font-family: 'Consolas', 'Segoe UI', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QPushButton#m_helpBtn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #38bdf8;
    font-family: 'Segoe UI', sans-serif;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#m_helpBtn:hover {
    background-color: #27354d;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton#m_helpBtn:pressed {
    background-color: #0f172a;
    border-color: #0284c7;
    color: #38bdf8;
}

QPushButton#m_powerBtn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #f87171;
}

QPushButton#m_powerBtn:hover {
    background-color: #7f1d1d;
    border-color: #ef4444;
}

QPushButton#m_powerBtn:pressed {
    background-color: #991b1b;
    border-color: #f87171;
}

/* --- Card Containers and Panels --- */
QFrame#formFrame, QFrame[isCard="true"] {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
}

QFrame#formFrame:hover, QFrame[isCard="true"]:hover {
    border: 1px solid #334155;
}

/* --- Form Field Labels --- */
QLabel#userLabel, QLabel#passLabel, QLabel#dbLabel {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
}

/* --- Input Controls --- */
QLineEdit {
    background-color: #0b0f19;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 8px;
    color: #f8fafc;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 11px;
}

QLineEdit:hover {
    border-color: #475569;
}

QLineEdit:focus {
    border: 1px solid #38bdf8;
    background-color: #0f172a;
}

/* --- Database Dropdown --- */
QComboBox {
    background-color: #0b0f19;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 8px;
    color: #f8fafc;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 11px;
}

QComboBox:hover {
    border-color: #38bdf8;
}

QComboBox:focus {
    border: 1px solid #38bdf8;
    background-color: #0f172a;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #1e293b;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #38bdf8;
    width: 0px;
    height: 0px;
    margin-top: 1px;
}

QComboBox QAbstractItemView {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #1e293b;
    selection-background-color: #1e293b;
    selection-color: #38bdf8;
    outline: none;
    padding: 2px;
}

/* --- Push Buttons --- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #222f44, stop:1 #1a2436);
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2d3e5a, stop:1 #223048);
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton:pressed {
    background: #141d2c;
    border-color: #0284c7;
    color: #38bdf8;
}

/* Primary Action: Login */
QPushButton#m_loginBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0284c7, stop:1 #0369a1);
    border: 1px solid #38bdf8;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#m_loginBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0ea5e9, stop:1 #0284c7);
    border-color: #7dd3fc;
}

QPushButton#m_loginBtn:pressed {
    background: #0369a1;
    border-color: #0284c7;
    color: #38bdf8;
}

/* Secondary Action: Cancel */
QPushButton#m_cancelBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #222f44, stop:1 #1a2436);
    border: 1px solid #334155;
    color: #cbd5e1;
}

QPushButton#m_cancelBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2d3e5a, stop:1 #223048);
    border-color: #f87171;
    color: #f87171;
}

QPushButton#m_cancelBtn:pressed {
    background: #141d2c;
    border-color: #ef4444;
    color: #ef4444;
}

/* --- Footer --- */
QLabel#footerLabel {
    color: #64748b;
    font-size: 10px;
}
</string>
