<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1280</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>CoffeeBreak V1.0 Telemetry Workstation</string>
  </property>
  <property name="windowIcon">
   <iconset resource="icons.qrc">
    <normaloff>:/icons/icons/database.ico</normaloff>:/icons/icons/database.ico</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ===================================================================
   COFFEEBREAK TELEMETRY - WORLD CLASS MISSION CONTROL THEME
   =================================================================== */

QMainWindow {
    background-color: #0b0f19;
    color: #f8fafc;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', 'Roboto', sans-serif;
    font-size: 11px;
}

QWidget#centralwidget {
    background-color: #0b0f19;
}

/* --- Splitters --- */
QSplitter::handle {
    background-color: #1e293b;
}
QSplitter::handle:horizontal {
    width: 3px;
}
QSplitter::handle:vertical {
    height: 3px;
}
QSplitter::handle:hover {
    background-color: #38bdf8;
}

/* --- Card Containers and Panels --- */
QFrame[isCard="true"] {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
}
QFrame[isCard="true"]:hover {
    border: 1px solid #334155;
}

QWidget#eventLogContainer, QWidget#rightPanelContainer {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
}

/* --- Card Headers --- */
QLabel[isHeader="true"], QLabel#eventLogHeader {
    color: #38bdf8;
    font-family: 'Segoe UI', sans-serif;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.8px;
    padding: 5px 10px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #162238, stop:1 #111a2c);
    border-bottom: 1px solid #1e293b;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QLabel[isBadge="true"] {
    background-color: #1e293b;
    color: #94a3b8;
    font-size: 9px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid #334155;
}

/* --- Toolbar --- */
QToolBar#mainToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #151e30, stop:1 #0c121e);
    border-bottom: 1px solid #1e293b;
    spacing: 6px;
    padding: 3px 8px;
}

QToolButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #27354d;
    border-color: #38bdf8;
    color: #38bdf8;
}

QToolButton:pressed {
    background-color: #0f172a;
    border-color: #0284c7;
    color: #0284c7;
}

/* --- Push Buttons --- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #222f44, stop:1 #1a2436);
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2d3e5a, stop:1 #223048);
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton:pressed {
    background: #141d2c;
    border-color: #0284c7;
    color: #38bdf8;
}

QPushButton:disabled {
    background: #111827;
    border-color: #1f2937;
    color: #4b5563;
}

/* Primary Action: Run Query */
QPushButton#btnRunQuery {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0284c7, stop:1 #0369a1);
    border: 1px solid #38bdf8;
    color: #ffffff;
    font-weight: bold;
}
QPushButton#btnRunQuery:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0ea5e9, stop:1 #0284c7);
    border-color: #7dd3fc;
}

/* Success Action: Save */
QPushButton#btnSave, QPushButton#btnSavePg {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #059669, stop:1 #047857);
    border: 1px solid #10b981;
    color: #ffffff;
}
QPushButton#btnSave:hover, QPushButton#btnSavePg:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10b981, stop:1 #059669);
    border-color: #34d399;
}

/* Secondary Action: Plot Data */
QPushButton#btnPlotData {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f46e5, stop:1 #4338ca);
    border: 1px solid #818cf8;
    color: #ffffff;
}
QPushButton#btnPlotData:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6366f1, stop:1 #4f46e5);
}

/* Live Stream Toggle Buttons */
QPushButton#btnLiveFeed, QPushButton#btnVideoToggle {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #064e3b, stop:1 #065f46);
    border: 1px solid #10b981;
    color: #34d399;
    font-weight: bold;
    padding: 4px 10px;
}
QPushButton#btnLiveFeed:hover, QPushButton#btnVideoToggle:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #047857, stop:1 #065f46);
    border-color: #34d399;
    color: #ffffff;
}
QPushButton#btnLiveFeed:checked, QPushButton#btnVideoToggle:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #065f46, stop:1 #047857);
    border: 1px solid #34d399;
    color: #a7f3d0;
}
QPushButton#btnLiveFeed:!checked, QPushButton#btnVideoToggle:!checked {
    background: #1f2937;
    border: 1px solid #6b7280;
    color: #9ca3af;
}

/* Danger Zone Buttons (Drop Table) */
QPushButton#btnDrop1, QPushButton#btnDrop2 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7f1d1d, stop:1 #991b1b);
    border: 1px solid #ef4444;
    color: #fee2e2;
}
QPushButton#btnDrop1:hover, QPushButton#btnDrop2:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #991b1b, stop:1 #b91c1c);
    border-color: #f87171;
}

/* Warning Buttons (Disconnect) */
QPushButton#btnDisconn1, QPushButton#btnDisconn2 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #78350f, stop:1 #92400e);
    border: 1px solid #f59e0b;
    color: #fef3c7;
}
QPushButton#btnDisconn1:hover, QPushButton#btnDisconn2:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #92400e, stop:1 #b45309);
    border-color: #fbbf24;
}

/* Exit Button */
QPushButton#btnExit {
    background: #1e293b;
    border: 1px solid #475569;
    color: #f87171;
}
QPushButton#btnExit:hover {
    background: #991b1b;
    border-color: #ef4444;
    color: #ffffff;
}

/* --- LineEdits --- */
QLineEdit {
    background-color: #0b0f19;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 8px;
    color: #f8fafc;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 11px;
}
QLineEdit:focus {
    border: 1px solid #38bdf8;
    background-color: #0f172a;
}
QLineEdit[readOnly="true"] {
    background-color: #080c14;
    border-color: #1e293b;
    color: #38bdf8;
}

/* --- Labels --- */
QLabel {
    color: #cbd5e1;
    font-size: 11px;
}

/* --- Status Badges --- */
QLabel#statusLabel {
    background-color: #064e3b;
    color: #34d399;
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: bold;
    font-size: 10px;
    letter-spacing: 0.5px;
}

QLabel#altitudeLabel, QLabel#positionLabel {
    background-color: #0b0f19;
    border: 1px solid #1e293b;
    border-radius: 4px;
    padding: 4px 8px;
    color: #94a3b8;
    font-family: 'Consolas', monospace;
    font-size: 10px;
}

QLabel#warnLbl {
    color: #f87171;
    font-weight: bold;
    font-size: 10px;
    padding: 4px 6px;
    background-color: rgba(127, 29, 29, 0.25);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 4px;
}

/* --- Group Boxes --- */
QGroupBox {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    margin-top: 18px;
    padding: 12px 8px 8px 8px;
    font-size: 10px;
    font-weight: bold;
    color: #38bdf8;
    letter-spacing: 0.5px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 3px;
    padding: 0 4px;
    background-color: #0f172a;
    color: #38bdf8;
}

/* --- Tab Widget --- */
QTabWidget::pane {
    border: 1px solid #1e293b;
    background: #0f172a;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

QTabBar::tab {
    background: #111827;
    border: 1px solid #1e293b;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 5px 12px;
    margin-right: 2px;
    font-size: 11px;
    font-weight: 500;
    color: #94a3b8;
}

QTabBar::tab:selected {
    background: #0f172a;
    border-color: #38bdf8;
    border-bottom-color: #0f172a;
    font-weight: bold;
    color: #38bdf8;
}

QTabBar::tab:hover:!selected {
    background: #1f293d;
    color: #f1f5f9;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #0b0f19;
    border: 1px solid #1e293b;
    border-radius: 4px;
    text-align: center;
    height: 16px;
    font-size: 10px;
    font-weight: bold;
    color: #ffffff;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #38bdf8);
    border-radius: 3px;
}

/* --- Event Log View (Terminal) --- */
QPlainTextEdit#eventLogView {
    background-color: #070a12;
    color: #22c55e;
    font-family: 'Consolas', 'Cascadia Code', 'Courier New', monospace;
    font-size: 9pt;
    border: 1px solid #1e293b;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    selection-background-color: #064e3b;
    selection-color: #34d399;
    padding: 6px;
}

/* --- ScrollBars --- */
QScrollBar:vertical {
    border: none;
    background: #070a12;
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #334155;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #070a12;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #475569;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #0b0f19;
    border-top: 1px solid #1e293b;
    color: #64748b;
    font-size: 10px;
}
</string>
